# ai-trader-signals — every variable below maps to a field on `Settings` in
# app/config.py. Generated from that field list; if you add a field there, add
# it here. Values shown are the code defaults unless marked REQUIRED.
#
# Unknown keys in .env are ignored (extra="ignore"), so a stale key here is
# harmless — a *missing* one is not: most defaults are empty strings, and an
# empty string disables the feature silently rather than failing at startup.

# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development                        # development | production

# ── NestJS API (watchlist + the chat agent's per-user trading context) ─
API_SERVICE_URL=http://localhost:8000          # base URL of the NestJS service
INTERNAL_API_KEY=                              # REQUIRED: shared secret for service-to-service calls; unset = every portfolio tool in the chat agent fails

# ── AWS ───────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1                          # region for SQS and Bedrock
AWS_ACCESS_KEY_ID=                             # leave blank on ECS/EC2 to use the task/instance role
AWS_SECRET_ACCESS_KEY=                         # pairs with the above

# ── SQS ───────────────────────────────────────────────────────────────
SQS_SIGNALS_QUEUE_URL=                         # signals are published here for the NestJS consumer; unset = signals are generated and dropped
SQS_TASKS_QUEUE_URL=                           # Celery broker queue for screener/brief tasks

# ── Bedrock Mantle (OpenAI-compatible LLM endpoint) ───────────────────
BEDROCK_API_KEY=                               # long-term key from the Bedrock console (API keys > Generate long-term API key); blank falls back to the unverified SigV4 auto-mint
BEDROCK_MODEL_ID=deepseek.v3.2                 # deepseek.v3.2 | mistral.mistral-large-3-675b-instruct | qwen.qwen3-235b-a22b-2507
BEDROCK_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1

# ── Market data / news ────────────────────────────────────────────────
NEWS_API_KEY=                                  # newsapi.org key; unset = no headlines, so no sentiment input at all
TAVILY_API_KEY=                                # tavily.com key for the chat agent's web_search tool; unset = tool returns a clear error
FRED_API_KEY=                                  # free, official St. Louis Fed key: https://fred.stlouisfed.org/docs/api/api_key.html; unset = no macro release data in the brief

# ── Signal thresholds ─────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.65                      # minimum LLM confidence to emit a signal
MIN_REWARD_RISK=1.5                            # minimum reward:risk ratio
MIN_ADX_TREND=20.0                             # skip choppy/range-bound regimes entirely
MIN_STOP_ATR_MULTIPLE=1.0                      # stop must be >= 1x ATR away (no noise-tight stops)
MAX_STOP_ATR_MULTIPLE=3.5                      # stop must be <= 3.5x ATR away (no sloppy sizing)
MIN_QUANT_CONFLUENCE=0.75                      # >=75% of rule-based indicators must agree with the LLM's direction

# ── Trading frictions ─────────────────────────────────────────────────
COST_PCT_ROUND_TRIP=0.12                       # all-in NSE intraday round-trip cost %; omitting it inverts backtest expectancy
MAX_ENTRY_DRIFT_ATR=0.25                       # cap on how far an LLM entry may sit from LTP, in ATRs

# ── Agent / LLM budgets ───────────────────────────────────────────────
AGENT_MAX_TOOL_ROUNDS=6                        # chat agent tool-calling iterations
SIGNAL_MAX_TOOL_ROUNDS=4                       # signal-generation tool-calling iterations
CHAT_HISTORY_TURNS=8                           # conversation turns resent as context
SENTIMENT_HEADLINE_LIMIT=10                    # cost control on the FinBERT call

# ── Risk limits (chat agent sizing tools) ─────────────────────────────
MAX_POSITION_PCT=20.0                          # max share of the account in any one position
MIN_RISK_PCT=0.25                              # clamp floor on requested per-trade risk
MAX_RISK_PCT=2.0                               # clamp ceiling on requested per-trade risk
WATCHLIST_SCAN_LIMIT=15                        # symbols the scan_watchlist tool will fetch in one turn

# ── Morning brief ─────────────────────────────────────────────────────
BRIEF_DRIVER_MOVE_THRESHOLD=1.0                # % overnight move for a cue to count as a driver
BRIEF_MIN_EXPECTED_MOVE=0.15                   # % implied move below which a reason is noise
BRIEF_UNIVERSE=                                # comma-separated override of DEFAULT_UNIVERSE; blank = built-in 25 symbols

# ── Concurrency (bounded — yfinance rate-limits aggressively) ─────────
SCREENER_CONCURRENCY=5                         # parallel symbols in a screener run
BRIEF_CONCURRENCY=4                            # parallel symbols in a morning brief

# ── FinBERT via Hugging Face Inference API ────────────────────────────
HF_API_TOKEN=                                  # free token from https://huggingface.co/settings/tokens; unset = sentiment unavailable (reported, not silently neutral)
FINBERT_MODEL=ProsusAI/finbert                 # HF model id used for headline scoring
