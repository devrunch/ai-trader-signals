# Redis (shared with NestJS API)
REDIS_URL=redis://localhost:6379/0

# NestJS API base URL (for internal callbacks)
API_SERVICE_URL=http://localhost:8000

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# NewsAPI (for FinBERT sentiment headlines)
NEWS_API_KEY=...

# Signal thresholds
CONFIDENCE_THRESHOLD=0.65
MIN_REWARD_RISK=1.5

# FinBERT model (HuggingFace ID)
FINBERT_MODEL=ProsusAI/finbert

# OANDA Forex paper trading (free demo account at oanda.com)
# 1. Register at https://www.oanda.com/register/
# 2. Go to "Manage Funds" > "API Access" > generate personal access token
OANDA_API_KEY=
OANDA_ACCOUNT_ID=101-001-XXXXXXXX-001
OANDA_ENV=practice
